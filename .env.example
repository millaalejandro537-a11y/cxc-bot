# SOLO NOMBRES de variables, sin valores. Los valores reales van en el entorno del proceso (gestor de secretos / Keychain / variables de la plataforma),
# nunca en este archivo, en Git, en argumentos de linea de comandos ni en logs. Ver docs/CONEXION-GELSYN-PRUEBAS.md.
#
# pruebas | produccion (obligatorio; no hay valor por defecto)
CXC_GELSYN_ENTORNO=
# https://<backend>  (HTTPS; sin credenciales ni parametros; NUNCA una URL postgres://)
CXC_GELSYN_BASE_URL=
# API key de SOLO LECTURA emitida por Gelsyn para la app autorizada en FINANZAS_APPS_AUTORIZADAS
CXC_GELSYN_API_KEY=
# Opcional: hosts de produccion conocidos, separados por coma (se bloquean en entorno 'pruebas')
CXC_GELSYN_HOSTS_PRODUCCION=
# Solo para produccion y con autorizacion humana expresa
CXC_GELSYN_CONFIRMAR_PRODUCCION=
# Ruta a cxc-reporting-core/src (cliente HTTP de solo lectura reutilizado)
CXC_REPORTING_SRC=
