# Copia este archivo a .env (nunca subas .env real a git) y genera valores
# propios. .env ya esta en .gitignore.
#
# Generar N8N_ENCRYPTION_KEY:   openssl rand -hex 32
# Generar N8N_BASIC_AUTH_PASSWORD: cualquier password fuerte.

N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambia-esto
N8N_ENCRYPTION_KEY=cambia-esto-tambien
